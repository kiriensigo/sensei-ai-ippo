---
import { SITE } from '../config/site';
const path = Astro.url.pathname;
const items = [
  { href: '/guide/', label: 'ガイド', match: (p: string) => p.startsWith('/guide/') && !p.startsWith('/guide/33-prompts') },
  { href: '/guide/33-prompts/', label: 'プロンプト集', match: (p: string) => p.startsWith('/guide/33-prompts') },
  { href: '/about/', label: 'このサイトについて', match: (p: string) => p.startsWith('/about') },
];
---
<header class="site-header">
  <div class="container">
    <a class="brand" href="/">
      <span class="brand-mark">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 19 L12 5 L19 19"></path><path d="M8.5 13 H15.5"></path></svg>
      </span>
      <span class="brand-text"><span class="brand-sub">先生のためのAI活用ガイド</span><span>{SITE.shortName}</span></span>
    </a>
    <nav class="nav" aria-label="メインメニュー">
      {items.map((i) => <a href={i.href} aria-current={i.match(path) ? 'page' : undefined}>{i.label}</a>)}
    </nav>
  </div>
</header>
