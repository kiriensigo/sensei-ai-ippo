---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import { getGuideBySection } from '../../lib/content';
const sections = await getGuideBySection();
let n = 0;
---
<Base title="ガイド（目次）" description="AIの使い方のきほん・約束・5つのコツ・場面別の例を、順番に読めるガイドです。">
  <div class="narrow">
    <header class="page-head">
      <nav class="breadcrumb" aria-label="パンくず"><a href="/">トップ</a> <span aria-hidden="true">/</span> ガイド</nav>
      <h1>ガイド（目次）</h1>
      <p>上から順に読むと、20分ほどで「とりあえず使える」ところまでいけます。気になるところだけ読んでもOKです。</p>
    </header>
    {sections.map((s) => (
      <section class="index-group">
        <h2>{s.name}</h2>
        <p class="meta">{s.desc}</p>
        <ol class="num-list">
          {s.pages.map((p) => {
            n++;
            return (
              <li><a href={`/guide/${p.id}/`}>
                <span class="no">{String(n).padStart(2, '0')}</span>
                <span class="body"><span class="ttl">{p.data.title}</span><span class="sub">{p.data.description}</span></span>
                <Icon name="chevron" color="#9aa6b6" />
              </a></li>
            );
          })}
        </ol>
      </section>
    ))}
  </div>
</Base>
