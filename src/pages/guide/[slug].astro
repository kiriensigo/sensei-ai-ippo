---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Toc from '../../components/Toc.astro';
import Icon from '../../components/Icon.astro';
import SafetyNotice from '../../components/SafetyNotice.astro';
import { SECTIONS } from '../../config/site';
import { getGuide, formatDate } from '../../lib/content';

export async function getStaticPaths() {
  const all = await getGuide();
  return all.map((entry, i) => ({
    params: { slug: entry.id },
    props: { entry, prev: all[i - 1], next: all[i + 1], index: i + 1, total: all.length },
  }));
}
const { entry, prev, next, index, total } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
const section = SECTIONS.find((s) => s.slug === d.section)!;
---
<Base title={d.title} description={d.description} noindex={d.draft}>
  <div class="guide-layout">
    <aside class="guide-side">
      <details class="toc-mobile">
        <summary><span>目次　<span style="color:var(--accent)">{index} / {total}</span></span><Icon name="down" size={18} color="#5b6675" /></summary>
        <Toc current={entry.id} />
      </details>
      <div class="toc-desktop"><Toc current={entry.id} /></div>
    </aside>

    <div class="guide-main">
      <nav class="breadcrumb" aria-label="パンくず">
        <a href="/">トップ</a> <span aria-hidden="true">/</span> <a href="/guide/">ガイド</a> <span aria-hidden="true">/</span> {section.name}
      </nav>
      <div class="step-label">{section.name}　{index} / {total}</div>
      <h1 class="article-title">{d.title}</h1>
      <p class="lead-text">{d.description}</p>

      <section class="point-box" aria-label="このページのポイント">
        <div class="point-title">このページのポイント</div>
        <ul>{d.summary.map((s) => <li><Icon name="check" color="#2f7d5b" stroke={2.4} />{s}</li>)}</ul>
      </section>

      <article class="prose">
        <Content />
      </article>

      {d.section !== 'basic' && <SafetyNotice />}

      <p class="checked">最終確認：{formatDate(d.checkedAt)}</p>

      <nav class="pager" aria-label="前後のページ">
        {prev ? (
          <a href={`/guide/${prev.id}/`}><span class="dir">まえへ</span><span class="ttl">{prev.data.navTitle ?? prev.data.title}</span></a>
        ) : <span />}
        {next ? (
          <a class="next" href={`/guide/${next.id}/`}><span class="dir">つぎへ</span><span class="ttl">{next.data.navTitle ?? next.data.title}</span></a>
        ) : (
          <a class="next" href="/guide/"><span class="dir">おわり</span><span class="ttl">目次にもどる</span></a>
        )}
      </nav>
    </div>
  </div>
</Base>
