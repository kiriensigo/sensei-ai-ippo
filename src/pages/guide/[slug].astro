---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Toc from '../../components/Toc.astro';
import SafetyNotice from '../../components/SafetyNotice.astro';
import { SECTIONS } from '../../config/site';
import { getGuide, formatDate } from '../../lib/content';

export async function getStaticPaths() {
  const all = await getGuide();
  return all.map((entry, i) => ({
    params: { slug: entry.id },
    props: { entry, prev: all[i - 1], next: all[i + 1], index: i + 1, total: all.length },
  }));
}
const { entry, prev, next, index, total } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
const section = SECTIONS.find((s) => s.slug === d.section)!;
---
<Base title={d.title} description={d.description} noindex={d.draft}>
  <div class="container guide-layout">
    <aside class="guide-side">
      <details class="toc-mobile">
        <summary>📖 目次を開く</summary>
        <Toc current={entry.id} />
      </details>
      <div class="toc-desktop"><Toc current={entry.id} /></div>
    </aside>

    <div class="guide-main">
      <nav class="breadcrumb" aria-label="パンくず">
        <a href="/">トップ</a> › <a href="/guide/">ガイド</a> › {section.name}
      </nav>
      <header class="article-head">
        <div class="step-label">{section.emoji} {section.name}　<span class="meta">{index} / {total}</span></div>
        <h1>{d.title}</h1>
        <p class="lead-text">{d.description}</p>
      </header>

      <section class="point-box" aria-label="このページのポイント">
        <div class="point-title">✅ このページのポイント</div>
        <ul>{d.summary.map((s) => <li>{s}</li>)}</ul>
      </section>

      <article class="prose">
        <Content />
      </article>

      {d.section !== 'basic' && <SafetyNotice />}

      <p class="meta" style="text-align:right">最終確認：{formatDate(d.checkedAt)}</p>

      <nav class="pager" aria-label="前後のページ">
        {prev ? (
          <a class="pager-link prev" href={`/guide/${prev.id}/`}><span class="meta">← まえへ</span><span>{prev.data.title}</span></a>
        ) : <span />}
        {next ? (
          <a class="pager-link next" href={`/guide/${next.id}/`}><span class="meta">つぎへ →</span><span>{next.data.title}</span></a>
        ) : (
          <a class="pager-link next" href="/guide/"><span class="meta">おわり</span><span>目次にもどる</span></a>
        )}
      </nav>
    </div>
  </div>
</Base>
